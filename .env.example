# ─────────────────────────────────────────────────────────────
# Rivya environment template.
# Copy to .env.local and fill in real values. NEVER commit .env.local.
# ─────────────────────────────────────────────────────────────

# Public base URL of the app (used for OAuth callbacks, emails, sitemap)
APP_URL=http://localhost:3000

# MongoDB Atlas connection string (required)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/rivya?retryWrites=true&w=majority

# Secret used to sign auth tokens. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Google OAuth (optional — Google login is hidden when unset)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary (optional — uploads disabled when unset)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay (optional — payments disabled when unset). Use test keys in development.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Google Maps JavaScript API key (optional — maps hidden when unset)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Transactional email via Resend (optional — emails are logged when unset)
EMAIL_API_KEY=
EMAIL_FROM="Rivya <hello@example.com>"

# Shared secret for scheduled jobs (booking reminders, hold expiry)
CRON_SECRET=

# Platform commission in basis points (1000 = 10%)
PLATFORM_COMMISSION_BPS=1000

# Log level: trace | debug | info | warn | error
LOG_LEVEL=info
